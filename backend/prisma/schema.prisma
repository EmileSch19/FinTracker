generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  password     String
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

model Category {
  id           String        @id @default(cuid())
  name         String
  type         String
  transactions Transaction[]
}

model Transaction {
  id         String   @id @default(cuid())
  date       DateTime
  label      String
  amount     Float
  type       String
  note       String?
  userId     String
  categoryId String
  user       User     @relation(fields: [userId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])
  createdAt  DateTime @default(now())
}